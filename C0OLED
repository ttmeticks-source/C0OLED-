--// Трекер + анти-удаление ×2 + taunt
local tracked = {}

local function watchPart(entry)
    if not entry.part then return end
    local conn
    conn = entry.part.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if conn then conn:Disconnect() end

            -- taunt "u tried haha"
            if entry.taunt ~= false then
                spawnTaunt(entry.pos)
            end

            entry.growth = (entry.growth or 1) * 2
            local newSize = Vector3.new(
                math.min(entry.size.X * entry.growth, MAX_PART_SIZE),
                math.min(entry.size.Y * entry.growth, MAX_PART_SIZE),
                math.min(entry.size.Z * entry.growth, MAX_PART_SIZE)
            )
            task.spawn(function()
                local p = createPart(entry.pos, newSize, entry.name, entry.anchored, entry.canCollide, entry.decalId, entry.onlyFace)
                if p then
                    entry.part = p
                    entry.size = newSize
                    watchPart(entry)
                end
            end)
        end
    end)
end

local function trackPart(pos, size, name, anchored, canCollide, decalId, part, onlyFace, taunt)
    table.insert(tracked, {
        pos = pos, size = size, name = name,
        anchored = anchored, canCollide = canCollide,
        decalId = decalId, part = part, onlyFace = onlyFace,
        taunt = taunt,
        growth = 1
    })
end

task.spawn(function()
    while true do
        task.wait(3)
        if api then
            for _, entry in ipairs(tracked) do
                if not entry.part or not entry.part.Parent then
                    if entry.taunt ~= false then spawnTaunt(entry.pos) end
                    entry.growth = (entry.growth or 1) * 2
                    local newSize = Vector3.new(
                        math.min(entry.size.X * entry.growth, MAX_PART_SIZE),
                        math.min(entry.size.Y * entry.growth, MAX_PART_SIZE),
                        math.min(entry.size.Z * entry.growth, MAX_PART_SIZE)
                    )
                    task.spawn(function()
                        local p = createPart(entry.pos, newSize, entry.name, entry.anchored, entry.canCollide, entry.decalId, entry.onlyFace)
                        if p then
                            entry.part = p
                            entry.size = newSize
                            watchPart(entry)
                        end
                    end)
                    task.wait(0.3)
                end
            end
        end
    end
end)

--// Небо (6 граней, collision off)
local skyParts = {}

local function buildSky(R)
    rebuildApi()
    if not api then return false, "no F3X" end

    for _, p in ipairs(skyParts) do
        pcall(function() if p and p.Parent then api.Remove(p) end end)
    end
    skyParts = {}

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "no char" end

    local center = hrp.Position
    R = R or 500
    if R * 2 > MAX_PART_SIZE then R = math.floor(MAX_PART_SIZE / 2) end

    local T = 20
    local faces = {
        {pos = center + Vector3.new(0, 0, -R), size = Vector3.new(R*2, R*2, T), face = Enum.NormalId.Back},
        {pos = center + Vector3.new(0, 0, R),  size = Vector3.new(R*2, R*2, T), face = Enum.NormalId.Front},
        {pos = center + Vector3.new(-R, 0, 0), size = Vector3.new(T, R*2, R*2), face = Enum.NormalId.Right},
        {pos = center + Vector3.new(R, 0, 0),  size = Vector3.new(T, R*2, R*2), face = Enum.NormalId.Left},
        {pos = center + Vector3.new(0, R, 0),  size = Vector3.new(R*2, T, R*2), face = Enum.NormalId.Bottom},
        {pos = center + Vector3.new(0, -R, 0), size = Vector3.new(R*2, T, R*2), face = Enum.NormalId.Top},
    }

    local built = 0
    for _, f in ipairs(faces) do
        local p = nil
        for attempt = 1, 3 do
            p = createPart(f.pos, f.size, randName(), true, false, DECAL_ID, f.face)
            if p then break end
            task.wait(0.3)
        end
        if p then
            pcall(function()
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false
            end)
            table.insert(skyParts, p)
            trackPart(f.pos, f.size, p.Name, true, false, DECAL_ID, p, f.face, true)
            watchPart(tracked[#tracked])
            built = built + 1
        end
        task.wait(0.15)
    end

    return built == 6, (built .. "/6 parts, R=" .. R)
end

local function removeSky()
    for _, p in ipairs(skyParts) do
        pcall(function() if p and p.Parent then api.Remove(p) end end)
    end
    skyParts = {}
end


local function bigDestruction(count)
    rebuildApi()
    if not api then return 0 end
    count = count or 500
    local origin = Vector3.new(0, 100, 0)
    local maxDim = 1500

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name == "Baseplate" or v.Name:lower():find("baseplate", 1, true)) then
            origin = v.CFrame.Position
            maxDim = math.max(v.Size.X, v.Size.Z) / 2
            break
        end
    end

    local n = 0
    for i = 1, count do
        task.spawn(function()
            local pos = origin + Vector3.new(
                math.random(-maxDim, maxDim),
                math.random(5, 2000),
                math.random(-maxDim, maxDim)
            )
            local before = snapshotParts()
            api.CreatePart(CFrame.new(pos), workspace)
            local p = findNewPart(before, pos, 0.5)
            if p then
                pcall(function() api.SetCollision(p, false) end)
                pcall(function() api.SetAnchor(p, false) end)
                pcall(function() api.CreateFire(p) end)
                pcall(function() api.CreateSmoke(p) end)
                pcall(function() api.Resize(p, Vector3.new(math.random(5,20), math.random(5,20), math.random(5,20)), p.CFrame) end)
                n = n + 1
            end
        end)
        if i % 50 == 0 then task.wait(0.02) end
    end

    pcall(function()
        Lighting.Ambient = Color3.fromRGB(255, 50, 0)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 30, 0)
        Lighting.Brightness = 3
        Lighting.FogColor = Color3.fromRGB(180, 0, 0)
        Lighting.FogEnd = 50
    end)

    return n

local function randName()
    local chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz0123456789"
    local s = ""
    for i = 1, 12 do
        local idx = math.random(1, #chars)
        s = s .. chars:sub(idx, idx)
    end
    return s
end

local OUR_NAMES = {}

--// BTools
local BT_NAMES = {"btools","btool","f3x","build","building tool","hoist","sync","syncapi","hammer","resize","surface"}

local function isToolLike(inst)
    if not inst:IsA("Tool") then return false end
    if inst:FindFirstChild("SyncAPI") then return true end
    local ln = inst.Name:lower()
    for _, n in ipairs(BT_NAMES) do
        if ln:find(n, 1, true) then return true end
    end
    if inst:FindFirstChildOfClass("LocalScript") or inst:FindFirstChildOfClass("RemoteEvent") or inst:FindFirstChildOfClass("RemoteFunction") then
        return true
    end
    return false
end

local function getContainers()
    local list = {}
    local bp = player:FindFirstChild("Backpack"); if bp then table.insert(list, bp) end
    local char = player.Character; if char then table.insert(list, char) end
    table.insert(list, ReplicatedStorage)
    table.insert(list, game:GetService("StarterPack"))
    table.insert(list, workspace)
    return list
end

local function findBToolsCandidates()
    local found, seen = {}, {}
    for _, c in ipairs(getContainers()) do
        pcall(function()
            for _, v in ipairs(c:GetDescendants()) do
                if not seen[v] and isToolLike(v) then
                    seen[v] = true
                    table.insert(found, v)
                end
            end
        end)
    end
    return found
end

local function getBToolsInBackpack()
    local bp = player:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, v in ipairs(bp:GetChildren()) do
        if isToolLike(v) then return v end
    end
    return nil
end

local function ensureBToolsInBackpack()
    if getBToolsInBackpack() then return true, "already" end
    local c = findBToolsCandidates()
    if #c == 0 then return false, "not found" end
    local bp = player:FindFirstChild("Backpack")
    if not bp then return false, "no backpack" end
    local n = 0
    for _, src in ipairs(c) do
        local ok = pcall(function()
            local cl = src:Clone()
            cl.Parent = bp
        end)
        if ok then n = n + 1 end
        if n >= 3 then break end
    end
    return n > 0, ("+" .. n)
end

local function unequipBTools()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, v in ipairs(char:GetChildren()) do
        if isToolLike(v) then
            pcall(function() hum:UnequipTools() end)
            break
        end
    end
end

--// F3X API
local api = nil
local hasF3X = false
local syncRemote = nil

local function findSyncAPI()
    for _, c in ipairs({player.Character, player, ReplicatedStorage, workspace, game:GetService("StarterPack")}) do
        if c then
            for _, v in ipairs(c:GetDescendants()) do
                if v.Name == "SyncAPI" and v:FindFirstChild("ServerEndpoint") then
                    return v
                end
            end
        end
    end
    return nil
end

local function rebuildApi()
    local syncAPI = findSyncAPI()
    hasF3X = syncAPI ~= nil
    if not hasF3X then api = nil; syncRemote = nil; return nil end
    syncRemote = syncAPI.ServerEndpoint
    pcall(function() syncRemote:InvokeServer("__warmup") end)

    local function _(a)
        pcall(function() syncRemote:InvokeServer(unpack(a)) end)
    end

    api = {}
    function api.CreatePart(cf, p) _({[1]="CreatePart",[2]="Normal",[3]=cf,[4]=p or workspace}) end
    function api.SetName(part, n) _({[1]="SetName",[2]={[1]=part},[3]=n}) end
    function api.SetLocked(part, b) _({[1]="SetLocked",[2]={[1]=part},[3]=b}) end
    function api.SetAnchor(part, b) _({[1]="SyncAnchor",[2]={{["Part"]=part,["Anchored"]=b}}}) end
    function api.Resize(part, s, cf) _({[1]="SyncResize",[2]={{["Part"]=part,["CFrame"]=cf,["Size"]=s}}}) end
    function api.SetCollision(part, b) _({[1]="SyncCollision",[2]={{["Part"]=part,["CanCollide"]=b}}}) end
    function api.SpawnDecal(part, s) _({[1]="CreateTextures",[2]={{["Part"]=part,["Face"]=s,["TextureType"]="Decal"}}}) end
    function api.AddDecal(part, a, s) _({[1]="SyncTexture",[2]={{["Part"]=part,["Face"]=s,["TextureType"]="Decal",["Texture"]="rbxassetid://"..a}}}) end
    function api.CreateFire(part) _({[1]="CreateLights",[2]={{["Part"]=part,["LightType"]="Fire"}}}) end
    function api.CreateSmoke(part) _({[1]="CreateLights",[2]={{["Part"]=part,["LightType"]="Smoke"}}}) end
    function api.Remove(part) _({[1]="Remove",[2]={[1]=part}}) end
    return api
end

rebuildApi()
print("[c0oled] F3X found:", hasF3X)


--// Хелперы
local function snapshotParts()
    local set = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then set[v] = true end
    end
    return set
end

local function findNewPart(before, pos, timeout)
    timeout = timeout or 2
    local t0 = tick()
    while tick() - t0 < timeout do
        local best, bestDist = nil, math.huge
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not before[v] and not OUR_NAMES[v.Name] and not v:FindFirstChildOfClass("Humanoid") then
                local d = (v.CFrame.Position - pos).Magnitude
                if d < bestDist then best, bestDist = v, d end
            end
        end
        if best then return best end
        task.wait(0.05)
    end
    return nil
end

local function applyDecalAllFaces(part, id)
    if not part or not part.Parent then return end
    for _, face in ipairs({
        Enum.NormalId.Front, Enum.NormalId.Back,
        Enum.NormalId.Right, Enum.NormalId.Left,
        Enum.NormalId.Bottom, Enum.NormalId.Top
    }) do
        pcall(function() api.SpawnDecal(part, face) end)
        pcall(function() api.AddDecal(part, id, face) end)
    end
end

local function createPart(pos, size, name, anchored, canCollide, decalId, onlyFace)
    rebuildApi()
    if not api then return nil end

    size = Vector3.new(
        math.min(size.X, MAX_PART_SIZE),
        math.min(size.Y, MAX_PART_SIZE),
        math.min(size.Z, MAX_PART_SIZE)
    )

    local before = snapshotParts()
    local cf = CFrame.new(pos)
    api.CreatePart(cf, workspace)
    local p = findNewPart(before, pos, 2)
    if not p then
        task.wait(0.3)
        p = findNewPart(before, pos, 1.5)
    end
    if not p then return nil end

    local nm = name or randName()
    OUR_NAMES[nm] = true
    pcall(function() api.SetCollision(p, canCollide or false) end)
    pcall(function() api.SetLocked(p, false) end)
    pcall(function() api.SetName(p, nm) end)
    pcall(function() api.SetAnchor(p, anchored ~= false) end)
    pcall(function() api.Resize(p, size, cf) end)

    task.defer(function()
        pcall(function() api.SetCollision(p, canCollide or false) end)
    end)

    if decalId then
        task.wait(0.15)
        if onlyFace then
            pcall(function() api.SpawnDecal(p, onlyFace) end)
            pcall(function() api.AddDecal(p, decalId, onlyFace) end)
        else
            applyDecalAllFaces(p, decalId)
        end
    end
    return p
end

